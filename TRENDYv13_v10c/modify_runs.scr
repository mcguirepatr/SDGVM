#!/bin/bash

exps="spin_accel spin_accelFS4 S0 S1 S2 S3 S5 FS4 FS42 FS5"

for exp in $exps; do
  sed -i -e 's/sdgvm_v8._debug/sdgvm_v8y_debug/g' $exp'/start_v10c.scr'
  sed -i -e 's/sdgvm_v8._debug/sdgvm_v8y_debug/g' $exp'/submit_v10c.sbatch'
  if [[ "$exp" == "spin_accel" ]]; then
     exp2="spin"
  elif [[ "$exp" == "spin_accelFS4" ]]; then
     exp2="spinFS4"
  elif [[ "$exp" == "FS42" ]]; then
     exp2="FS4"
  else
     exp2=$exp
  fi
  sed -i -e 's/324 324/324 325/g' $exp'/input_global_v5a10g10c'$exp2'.dat'
  sed -i -e 's/v2h_2023/v2h_2024/g' $exp'/input_global_v5a10g10c'$exp2'.dat'
  sed -i -e 's/1700 1 324/1700 1 325/g' $exp'/input_global_v5a10g10c'$exp2'.dat'
  sed -i -e 's/1700 324 324/1700 324 325/g' $exp'/input_global_v5a10g10c'$exp2'.dat'
  sed -i -e 's/1700 321 324/1700 321 325/g' $exp'/input_global_v5a10g10c'$exp2'.dat'
  
  if [[ "$exp" == "FS42" ]]; then
     sed -i -e 's/4 1700 321 325/5 1700 1 325/g' $exp'/input_global_v5a10g10c'$exp2'.dat'
     sed -i -e 's/2v2h_2024/2v2h_2024\/pre-ind/g' $exp'/input_global_v5a10g10c'$exp2'.dat'
  fi  
done

exps="spin_accelFS FS4 FS5"

for exp in $exps; do
  sed -i -e 's/spin_accelFS4/spin_accelFS/g' $exp'/start_v10c.scr'
  sed -i -e 's/spin_accelFS4/spin_accelFS/g' $exp'/submit_v10c.sbatch'
  sed -i -e 's/spin_accelFS4/spin_accelFS/g' $exp'/submit_pp_v10c.sbatch'
done
