#!/bin/bash

exps1="S0 S1 S2 S3 S5"
exps2="FS4 FS5"
spins="spin_accel spin_accelFS"

for spin in $spins; do
  if [[ "$spin" == "spin_accel" ]]; then 
     exps=$exps1
  else
     exps=$exps2
  fi
  cd $spin 
  ./start_v10c.scr
  spinid0=$(sbatch submit_v10c.sbatch)
  spinid=$(echo "$spinid0" | awk -F " " '{ print $4 }')

  echo Running $spin $spinid
  sed -i -e '/afterok/d' 'submit_pp_v10c.sbatch'
  sbatch --dependency=afterok:$spinid submit_pp_v10c.sbatch
  cd .. 
  for exp in $exps; do
    cd $exp
    ./start_v10c.scr
    sed -i -e '/afterok/d' 'submit_v10c.sbatch'
    echo "sbatch --dependency=afterok:"$spinid "submit_v10c.sbatch" 
    expid0=$(sbatch --dependency=afterok:$spinid submit_v10c.sbatch)
    expid=$(echo "$expid0" | awk -F " " '{ print $4 }')
    echo Running $exp $expid
    sed -i -e '/afterok/d' 'submit_pp_v10c.sbatch'
    sbatch --dependency=afterok:$expid submit_pp_v10c.sbatch
    cd .. 
  done
done
