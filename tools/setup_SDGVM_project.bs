#!/bin/bash

# Sets up an SDGVM project composed of multiple related runs of SDGVM
# calls setup_SDGVM.bs which sets up each individual run 

# Arguments:
# $1 - SDGVMUSER (required) - options: ORNL_APW, UR_PCM
# $2 - project name (required)
# $3 - HOME directory path relative to root (optional)
# $4 - SUBPROJECT name (optional, but $3 must be specified if a subproject is to be created)

# Currently the names of the various runs are hard coded in the environment variable SIMS 
#SIMS=( NC_zen0_beers C_zen0_beers C_zen_beers C_zen0_beersC C_zen_beersC NC_zen0_LP C_zen0_LP C_zen_LP  )
#SIMS=( Walker_N_ModA Walker_N_ModA_Tacc Kattge_ModA Kattge_ModA_Tacc  )
#SIMS=( Constant Constant_ModA Constant_ModA_Tacc LUNA LUNA_ModA LUNA_ModA_Tacc  )
#SIMS=( spin_accel S0 S1 S2 S3  )
#SIMS=( tpu0 tpu1 tpu2 tpu3  )
#SIMS=( spin_accelv7 S0v7 S1v7 S2v7 S3v7 S4v7  )
#SIMS=( spin_accelv8 spin_shortv8 S0v8 S2p1v8 S2p1_2017_v8 S2p2v8 S2p3v8 )
#SIMS=( spin_accelv7 S0v7 S1v7 S3v7 spin_accelv7_npslim S0v7_npslim S1v7_npslim S3v7_npslim spin_accelv7_bamort S0v7_bamort S1v7_bamort S3v7_bamort )
#SIMS=( spin_accelv7 ) 
#For TRENDYv7:
#SIMS=( spin_accelv7 S0v7 S1v7 S2v7 S3v7 S4v7  )
SIMS=( spin_accelv7 S0v7 S1v7 S2v7 S3v7 S4v7 S8v7 )
#For Droughtv8:
#SIMS=( spin_accelv8 spin_shortv8 S0v8 S2p1v8 S2p1_2017_v8 S2p2v8 S2p3v8 )
#For TRENDYv8:
#SIMS=( spin_accelv8 spin_shortv8 S0v8 S1v8 S2v8 S3v8 S4v8  )

# institute and user tag to customise simulation to user space and machine
echo ""
SDGVMUSER="$1"
#SDGVMUSER="ORNL_APW"
echo $SDGVMUSER
echo ""
echo ""
if [ $SDGVMUSER == 'ORNL_APW' ]; then
  HOME=~/models/SDGVM
  # relative to HOME
  PROJECTS_DIR=/run/
  # cluster queuing variables
  #BATCHPROC=pbs
  #BATCHPROCCOM="qsub submit.pbs"
  BATCHPROC=sbatch
  BATCHPROCCOM="sbatch submit.sbatch"

elif [ $SDGVMUSER == 'UR_PCM' ]; then
  HOME=/group_workspaces/jasmin2/nexcs/pmcguire
  # relative to HOME
  PROJECTS_DIR=/sdgvmR/
  # cluster queuing variables
  BATCHPROC=bsub
  BATCHPROCCOM="bsub < submit.bsub"
fi

# SDGVM directory - source code, run directories, input data are all subdirs of HOME
if [ ! -z $3 ]; then HOME=$3; fi

# relative to HOME, where all SDGVM simulations live
PDIR=${HOME}${PROJECTS_DIR}

# directory of specific project, relative to PDIR
PROJECT=$2

# a label for additional simulations within PROJECT 
SUBPROJECT=''
if [ ! -z $4 ]; then SUBPROJECT=_$4; fi

# setup project directories
mkdir -p $PDIR/$PROJECT
mkdir -p $PDIR/$PROJECT/tools
mkdir -p $PDIR/$PROJECT/tools/logs

# setup project run script 
cp run_project_template.bs  $PDIR/$PROJECT/run_${PROJECT}${SUBPROJECT}.bs
sed -i "s@#S#@${SIMS[*]}@"  $PDIR/$PROJECT/run_${PROJECT}${SUBPROJECT}.bs
sed -i "s@#BATCHPROCCOM#@${BATCHPROCCOM}@"  $PDIR/$PROJECT/run_${PROJECT}${SUBPROJECT}.bs

# setup project tools
cp ./project_tools/* $PDIR/$PROJECT/tools
sed -i "s@#PROJECT#@$PROJECT@"          $PDIR/$PROJECT/tools/*bs
sed -i "s@#PROJDIR#@${PDIR}${PROJECT}@" $PDIR/$PROJECT/tools/*bs

# set up runs within project
for s in ${SIMS[*]};do
 echo $s
 ./setup_SDGVM.bs $SDGVMUSER $HOME $PROJECT $s 
done



### END ###
