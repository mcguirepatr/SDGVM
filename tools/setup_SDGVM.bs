#!/bin/bash

# This script is designed to copy a template SDGVM directory into an actual run directory
# must be called from the script 'setup_SDGVM_project.bs' to set up multiple runs within a project
# the script renames the directories specified in the run and submit scripts
# once a run is setup the only file that needs editing is the input file (input*.dat)

# Arguments:
# $1 - run name (required) -- relative to SDGVM_PDIR/SDGVM_PROJECT
RUN=$1


#### TAGGED FOR RESTORATION TO ORIGINAL 
# copy blank run from:
#CPDIR=$SDGVM_HOME$SDGVM_MOD$SDGVM_CPRUN
CPDIR=/mnt/disk2/models/sdgvm/$SDGVM_CPRUN

# to:
RUNDIR=$SDGVM_PDIR/$SDGVM_PROJECT/$RUN/


# set up run directories
mkdir $RUNDIR
mkdir $RUNDIR/logs


# copy template files
cd $CPDIR
cp *param* $RUNDIR
cp *.${SDGVM_BATCHPROC} $RUNDIR
cp clean.bs $RUNDIR
cp run_postprocessing.bs $RUNDIR


#### TAGGED FOR ADDITION TO a RUNTYPE ARGUMENT 
# select and copy template run file
DEFTRUN=run_SDGVM.bs
RUNF=$DEFTRUN 
SPECRUN=`echo $SDGVM_PROJECT | grep TRENDY`
if [ ! -z $SPECRUN ]; then RUNF=run_SDGVM_TRENDYv7.bs; fi
#if [ ! -z $SPECRUN ]; then RUNF=run_SDGVM_TRENDYv8.bs; fi
echo "Run file: " $RUNF
cp $RUNF ${RUNDIR}$DEFTRUN
cp $SDGVM_RUN ${RUNDIR}$DEFTRUN


# select and copy template input file
DEFTIN=input_global.dat
SPECIN=`ls input* | grep $RUN`
if [ ! -z $SPECIN ]; then 
 INPUT=$SPECIN
else 
 INPUT=$DEFTIN 
fi
echo "Input file: " $INPUT
cp $INPUT $RUNDIR


# modify run files
# submit script
sed -i "s@#RUNDIR#@$RUNDIR@"                   ${RUNDIR}submit*.${SDGVM_BATCHPROC}
sed -i "s@#PROJECT#@$SDGVM_PROJECT@"           ${RUNDIR}submit*.${SDGVM_BATCHPROC}
sed -i "s@#SIM#@$RUN@"                         ${RUNDIR}submit*.${SDGVM_BATCHPROC}
sed -i "s/#EMAIL#/$SDGVM_USER_EMAIL/"          ${RUNDIR}submit*.${SDGVM_BATCHPROC}
sed -i "s@#ACCOUNT#@$SDGVM_USER_ACCOUNT@"      ${RUNDIR}submit*.${SDGVM_BATCHPROC}
sed -i "s@#QUEUE#@$SDGVM_USER_QUEUE@"          ${RUNDIR}submit*.${SDGVM_BATCHPROC}
sed -i "s@#PARTITION#@$SDGVM_USER_PARTITION@"  ${RUNDIR}submit*.${SDGVM_BATCHPROC}

# SDGVM run file (called by submit script)
sed -i "s@#HOME#@$SDGVM_HOME@"                 ${RUNDIR}run_SDGVM.bs
sed -i "s@#MOD#@$SDGVM_MOD@"                   ${RUNDIR}run_SDGVM.bs
sed -i "s@#DATA#@$SDGVM_DATA@"                 ${RUNDIR}run_SDGVM.bs
sed -i "s@#INPUT#@$INPUT@"                     ${RUNDIR}run_SDGVM.bs
sed -i "s@#SPIN#@$SDGVM_SPIN@"                 ${RUNDIR}run_SDGVM.bs

# SDGVM input file (commandline argument to SDGVM in run file, configures model run)
sed -i "s@#DATA#@$SDGVM_DATA@"                 ${RUNDIR}$INPUT
sed -i "s@#HOME#@$SDGVM_HOME@"                 ${RUNDIR}$INPUT

# postprocessing script (called by submit sccript after completion of SDGVM run file execution)
sed -i "s@#HOME#@$SDGVM_HOME@"                 ${RUNDIR}run_postprocessing.bs
sed -i "s@#MOD#@$SDGVM_MOD@"                   ${RUNDIR}run_postprocessing.bs
sed -i "s@#DIR#@$SDGVM_PDIR@"                  ${RUNDIR}run_postprocessing.bs
sed -i "s@#PDIR#@$SDGVM_PDIR$SDGVM_PROJECT@"   ${RUNDIR}run_postprocessing.bs
sed -i "s@#SIM#@$RUN@"                         ${RUNDIR}run_postprocessing.bs
sed -i "s@#SDGVMUSER#@$SDGVM_USER@"            ${RUNDIR}run_postprocessing.bs



### END ### 
